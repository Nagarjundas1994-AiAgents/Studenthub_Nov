
### =====================================================
### STUDENTHUB - STUDENT SERVICE TEST FILE
### =====================================================

@baseUrl = http://localhost:4004
@service = {{baseUrl}}/odata/v4/student
@studentId = 88888888-8888-4888-8888-888888888888
@studentId2 = 11111111-1111-4111-8111-111111111111
@createdStudentId = bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb

### =====================================================
### 1. GET ALL STUDENTS
### =====================================================

GET {{service}}/Students
Accept: application/json


### =====================================================
### 2. GET A SPECIFIC STUDENT
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 3. CHANGE STUDENT DEPARTMENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.changeDepartment
Content-Type: application/json
Accept: application/json

{
    "Department": "MECH"
}


### =====================================================
### 4. VERIFY DEPARTMENT UPDATE
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 5. CHANGE DEPARTMENT AGAIN
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.changeDepartment
Content-Type: application/json
Accept: application/json

{
    "Department": "MECH"
}


### =====================================================
### 6. TEST INVALID STUDENT ID
### Expected: 404 Not Found
### =====================================================

POST {{service}}/Students(INVALID001)/StudentService.changeDepartment
Content-Type: application/json
Accept: application/json

{
    "Department": "CSE"
}


### =====================================================
### 7. GET ENROLLED COURSES
### Bound Function
### =====================================================

GET {{service}}/Students({{studentId}})/StudentService.getEnrolledCourses()
Accept: application/json


### =====================================================
### 8. GRADUATE STUDENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.graduateStudent
Content-Type: application/json
Accept: application/json

{}


### =====================================================
### 9. VERIFY GRADUATION STATUS
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 10. DELETE STUDENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.deleteStudent
Content-Type: application/json
Accept: application/json

{}


### =====================================================
### 11. VERIFY STUDENT DELETION
### Expected: 404 Not Found
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 12. CREATE STUDENT
### Unbound Action
### =====================================================

POST {{service}}/createStudent
Content-Type: application/json
Accept: application/json

{
    "name": "Test Student",
    "email": "test.student@example.com",
    "department": "MECH",
    "status": "Active",
    "ID": "{{createdStudentId}}",
    "bpNumber": "1000000049"
}


### =====================================================
### 13. VERIFY NEW STUDENT
### =====================================================

GET {{service}}/Students({{createdStudentId}})
Accept: application/json


### =====================================================
### 14. UPDATE STUDENT
### Unbound Action
### =====================================================

POST {{service}}/updateStudent
Content-Type: application/json
Accept: application/json

{
    "name": "Test Student Updated",
    "email": "test.student.updated@example.com",
    "department": "ECE",
    "status": "Active",
    "ID": "{{createdStudentId}}",
    "bpNumber": "1000000049"
}


### =====================================================
### 15. VERIFY STUDENT UPDATE
### =====================================================

GET {{service}}/Students({{createdStudentId}})
Accept: application/json



### =====================================================
### 16. DELETE STUDENT
### Standard OData DELETE Endpoint
### =====================================================

DELETE {{service}}/Students({{createdStudentId}})
Accept: application/json


### =====================================================
### 17. VERIFY STUDENT DELETION
### Expected: 404 Not Found
### =====================================================

GET {{service}}/Students({{createdStudentId}})
Accept: application/json


### =====================================================
### 18. GET ENROLLED COURSES (BEFORE ENROLLING)
### Bound Function
### =====================================================

GET {{service}}/Students({{studentId2}})/StudentService.getEnrolledCourses()
Accept: application/json


### =====================================================
### 19. GET AVERAGE CREDITS (BEFORE ENROLLING)
### Bound Function
### =====================================================

GET {{service}}/Students({{studentId2}})/StudentService.getAverageCredits()
Accept: application/json


### =====================================================
### 20. ENROLL STUDENT IN A COURSE
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId2}})/StudentService.enrollToCourse
Content-Type: application/json
Accept: application/json

{
    "courseCode": "CS102"
}


### =====================================================
### 21. VERIFY ENROLLMENT
### =====================================================

GET {{service}}/Students({{studentId2}})/StudentService.getEnrolledCourses()
Accept: application/json


### =====================================================
### 22. VERIFY AVERAGE CREDITS AFTER ENROLLING
### Expected: 3.5
### =====================================================

GET {{service}}/Students({{studentId2}})/StudentService.getAverageCredits()
Accept: application/json


### =====================================================
### 23. ENROLL IN THE SAME COURSE AGAIN
### Expected: 409 Conflict
### =====================================================

POST {{service}}/Students({{studentId2}})/StudentService.enrollToCourse
Content-Type: application/json
Accept: application/json

{
    "courseCode": "CS102"
}


### =====================================================
### 24. DROP A COURSE
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId2}})/StudentService.dropCourse
Content-Type: application/json
Accept: application/json

{
    "courseCode": "CS102"
}


### =====================================================
### 25. VERIFY COURSE WAS DROPPED
### Expected: Only CS101
### =====================================================

GET {{service}}/Students({{studentId2}})/StudentService.getEnrolledCourses()
Accept: application/json


### =====================================================
### 26. DROP A COURSE THE STUDENT IS NOT ENROLLED IN
### Expected: 404 Not Found
### =====================================================

POST {{service}}/Students({{studentId2}})/StudentService.dropCourse
Content-Type: application/json
Accept: application/json

{
    "courseCode": "CS105"
}


### =====================================================
### 27. SUSPEND STUDENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId2}})/StudentService.suspendStudent
Content-Type: application/json
Accept: application/json

{}


### =====================================================
### 28. ACTIVATE STUDENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId2}})/StudentService.activateStudent
Content-Type: application/json
Accept: application/json

{}


### =====================================================
### 29. GET STUDENTS BY DEPARTMENT
### Unbound Function
### =====================================================

GET {{service}}/getStudentsByDepartment(department='CSE')
Accept: application/json


### =====================================================
### 30. GET STUDENT COUNT
### Unbound Function
### =====================================================

GET {{service}}/getStudentCount()
Accept: application/json


### =====================================================
### 31. UPDATE STUDENT WITH INVALID EMAIL
### Expected: 400 Bad Request
### =====================================================

POST {{service}}/updateStudent
Content-Type: application/json
Accept: application/json

{
    "email": "not-an-email",
    "ID": "{{studentId2}}"
}

