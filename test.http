
### =====================================================
### STUDENTHUB - STUDENT SERVICE TEST FILE
### =====================================================

@baseUrl = http://localhost:4004
@service = {{baseUrl}}/odata/v4/student
@studentId = 88888888-8888-4888-8888-888888888888

### =====================================================
### 1. GET ALL STUDENTS
### =====================================================

GET {{service}}/Students
Accept: application/json


### =====================================================
### 2. GET A SPECIFIC STUDENT
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 3. CHANGE STUDENT DEPARTMENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.changeDepartment
Content-Type: application/json
Accept: application/json

{
    "Department": "MECH"
}


### =====================================================
### 4. VERIFY DEPARTMENT UPDATE
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 5. CHANGE DEPARTMENT AGAIN
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.changeDepartment
Content-Type: application/json
Accept: application/json

{
    "Department": "MECH"
}


### =====================================================
### 6. TEST INVALID STUDENT ID
### Expected: 404 Not Found
### =====================================================

POST {{service}}/Students(INVALID001)/StudentService.changeDepartment
Content-Type: application/json
Accept: application/json

{
    "Department": "CSE"
}


### =====================================================
### 7. GET ENROLLED COURSES
### Bound Function
### =====================================================

GET {{service}}/Students({{studentId}})/StudentService.getEnrolledCourses()
Accept: application/json


### =====================================================
### 8. GRADUATE STUDENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.graduateStudent
Content-Type: application/json
Accept: application/json

{}


### =====================================================
### 9. VERIFY GRADUATION STATUS
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 10. DELETE STUDENT
### Bound Action
### =====================================================

POST {{service}}/Students({{studentId}})/StudentService.deleteStudent
Content-Type: application/json
Accept: application/json

{}


### =====================================================
### 11. VERIFY STUDENT DELETION
### Expected: 404 Not Found
### =====================================================

GET {{service}}/Students({{studentId}})
Accept: application/json


### =====================================================
### 12. CREATE STUDENT
### Unbound Action
### =====================================================

POST {{service}}/createStudent
Content-Type: application/json
Accept: application/json

{
    "name": "Venkat",
    "email": "Venkat@example.com",
    "department": "MECH",
    "status": "Active",
    "ID": "99999999-9999-56999-8966-999999999999",
    "bpNumber": "1000000049"
}


### =====================================================
### 13. VERIFY NEW STUDENT
### =====================================================

GET {{service}}/Students(99999999-9999-55999-8999-999999999999)
Accept: application/json


### =====================================================
### 14. UPDATE STUDENT
### Unbound Action
### =====================================================

POST {{service}}/updateStudent
Content-Type: application/json
Accept: application/json

{
    "name": "Rahul Das Updated",
    "email": "rahul.updated@example.com",
    "department": "ECE",
    "status": "Active",
    "ID": "99999999-9999-4999-8999-999999999999",
    "bpNumber": "1000000099"
}


### =====================================================
### 15. VERIFY STUDENT UPDATE
### =====================================================

GET {{service}}/Students(99999999-9999-4999-8999-999999999999)
Accept: application/json
